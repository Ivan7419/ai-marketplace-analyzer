generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Analysis {
  id String @id @default(cuid())

  query         String
  marketplace   String
  market        String
  businessModel String
  targets       Json?

  result Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([marketplace])
  @@index([market])
}
